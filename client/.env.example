# Copy to client/.env

# NextAuth — must match how you open the app in the browser (scheme + host, no trailing slash)
NEXTAUTH_URL=http://localhost:3000
# Cloudflare Tunnel example:
# NEXTAUTH_URL=https://text-to-sql.ansh314creativecorner.dpdns.org
# Behind a proxy/tunnel, also set on the client container (Auth.js / some hosts):
# AUTH_TRUST_HOST=true
NEXTAUTH_SECRET=

# Google OAuth — Authorized redirect URI:
#   http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth — use an **OAuth App** (not a GitHub App)
# https://github.com/settings/developers → OAuth Apps → your app
# Authorization callback URL (exact, no trailing slash):
#   http://localhost:3000/api/auth/callback/github
# Optional second URL if you browse via 127.0.0.1:
#   http://127.0.0.1:3000/api/auth/callback/github
GITHUB_ID=
GITHUB_SECRET=
# Aliases also supported: GITHUB_CLIENT_ID, GITHUB_CLIENT_SECRET

# App Postgres (users, saved databases, chats). Optional ?schema=public is OK (stripped for pg).
# Local dev: match your Postgres. Compose overrides → postgres://postgres:password@postgres:5432/text-to-sql
DATABASE_URL=postgres://postgres:password@localhost:5432/text-to-sql

# Flask text-to-SQL server
FLASK_URL=http://127.0.0.1:8000

# Password reset email (Nodemailer)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=user@gmail.com
SMTP_PASS="app pass"
SMTP_FROM=noreply@domain.com

# This email has unlimited queries. Everyone else is capped at NON_ADMIN_QUERY_LIMIT.
# Also receives "New login" mail (time + location if the browser shared it).
ADMIN_EMAIL_ID=admin@example.com
NON_ADMIN_QUERY_LIMIT=5
