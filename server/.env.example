# Copy this file to .env  ->  cp .env.example .env

# OpenRouter (get a key at https://openrouter.ai/keys)
# One line, no quotes: OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_API_KEY=sk-or-v1-REPLACE_ME
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Any model that supports tool calling, e.g.:
#   openai/gpt-4o-mini, anthropic/claude-3.5-sonnet, google/gemini-2.0-flash-001,
#   deepseek/deepseek-chat, meta-llama/llama-3.3-70b-instruct
OPENROUTER_MODEL=openai/gpt-4o-mini

# How many old messages to send back to the LLM
HISTORY_LIMIT=4

# Safety limits
MAX_ROWS=200
QUERY_TIMEOUT_MS=15000

# Which websites may call the Flask API (comma separated). Use your real site URL in Docker, e.g. http://192.168.1.42:3000
CORS_ORIGINS=http://localhost:3000
