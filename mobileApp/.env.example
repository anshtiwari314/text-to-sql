# Next.js server (the `client` app on this repo).
# The phone calls this URL for sign-in, chat, databases, and schemas.
# Restart Expo after you change it (`npx expo start`).
#
# This computer / iOS simulator:
EXPO_PUBLIC_API_URL=http://localhost:3000
#
# Android emulator (localhost on the emulator is the phone, not your PC):
# EXPO_PUBLIC_API_URL=http://10.0.2.2:3000
#
# Physical phone on the same Wi-Fi (use this computer's LAN address):
# EXPO_PUBLIC_API_URL=http://192.168.1.42:3000
#
# Must be the same host the Next server prints, and the same value as
# NEXTAUTH_URL in client/.env when you use Google or GitHub.
#
# Web OAuth client id (public). Same value as GOOGLE_CLIENT_ID in client/.env.
# The app sends Google's idToken to POST /api/auth/mobile/google.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
#
# Reversed iOS client id, like com.googleusercontent.apps.123456.
# Needed for the Google sign-in sheet on iPhone. Leave empty on Android-only.
EXPO_PUBLIC_GOOGLE_IOS_URL_SCHEME=
#
# GitHub OAuth App client id (public). Same value as GITHUB_ID in client/.env.
# Also add this callback in the GitHub OAuth App:
#   sqlai://oauth/github
# The client secret stays in client/.env. The app posts the code to
# POST /api/auth/mobile/github/token and receives a session token.
EXPO_PUBLIC_GITHUB_CLIENT_ID=
