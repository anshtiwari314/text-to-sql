# Copy to compose.env and fill in secrets, then:
#   docker compose --env-file compose.env up --build

POSTGRES_USER=sqlapp
POSTGRES_PASSWORD=sqlapp
POSTGRES_DB=sql_app
POSTGRES_PORT=5432

CLIENT_PORT=3000
FLASK_PORT=8000

NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=generate-a-long-random-string

OPENROUTER_API_KEY=sk-or-v1-REPLACE_ME
OPENROUTER_MODEL=openai/gpt-4o-mini
CORS_ORIGINS=http://localhost:3000

# OAuth / SMTP — optional for local docker
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_ID=
GITHUB_SECRET=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
